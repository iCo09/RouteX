PROJECT_NAME="RouteX - Bus Ticket Booking Platform"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL configuration
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="routex_user"
POSTGRES_PASSWORD="routex_password"
POSTGRES_DB="routex_db"

# Optional direct DATABASE_URL override (defaults to postgresql+asyncpg://user:pass@host:port/db)
DATABASE_URL="postgresql+asyncpg://routex_user:routex_password@127.0.0.1:5432/routex_db"
